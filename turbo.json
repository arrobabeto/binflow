{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".nuxt/**"]
    },
    "check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "BINFLOW_LIVE_EXECUTION_ENABLED",
        "LOGFIRE_TOKEN",
        "LOGFIRE_SERVICE_NAME",
        "OTEL_SERVICE_NAME"
      ],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "^lint"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["BINFLOW_TEST_DATABASE_URL"],
      "outputs": ["coverage/**"]
    }
  }
}
