{
  "name": "@binflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --import ./src/instrumentation.ts src/server.ts",
    "lint": "eslint src --max-warnings=0",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@binflow/auth": "workspace:*",
    "@binflow/contracts": "workspace:*",
    "@binflow/db": "workspace:*",
    "@binflow/domain": "workspace:*",
    "@binflow/integration-admin": "workspace:*",
    "@binflow/observability": "workspace:*",
    "@binflow/onboarding": "workspace:*",
    "@binflow/secrets": "workspace:*",
    "@binflow/tools": "workspace:*",
    "@binflow/workflows": "workspace:*",
    "fastify": "5.11.3",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
