{
  "name": "@binflow/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate",
    "lint": "eslint src drizzle.config.ts --max-warnings=0",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@binflow/contracts": "workspace:*",
    "@binflow/domain": "workspace:*",
    "@binflow/secrets": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10"
  }
}
