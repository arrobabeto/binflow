{
  "name": "binflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "binflow": "pnpm --filter @binflow/cli start",
    "build": "turbo run build",
    "check": "turbo run check",
    "check:workspaces": "node scripts/check-workspaces.mjs",
    "dev": "PORT=${PORT:-2040} BINFLOW_PUBLIC_URL=${BINFLOW_PUBLIC_URL:-http://localhost:6060} BINFLOW_INTERNAL_API_URL=${BINFLOW_INTERNAL_API_URL:-http://localhost:2040} turbo run dev --parallel",
    "dev:live": "PORT=${PORT:-2040} BINFLOW_PUBLIC_URL=${BINFLOW_PUBLIC_URL:-http://localhost:6060} BINFLOW_INTERNAL_API_URL=${BINFLOW_INTERNAL_API_URL:-http://localhost:2040} BINFLOW_LIVE_EXECUTION_ENABLED=true turbo run dev --parallel",
    "dev:lan": "node scripts/dev-lan.mjs dev",
    "dev:live:lan": "node scripts/dev-lan.mjs dev:live",
    "db:generate": "pnpm --filter @binflow/db generate",
    "db:migrate": "pnpm --filter @binflow/db migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
